# Copy to .env for reference. Export variables into your shell; no .env loader is assumed.
DATAFORGE_DATA_DIR=./data/demo
DATAFORGE_KNOWLEDGE_DIR=./knowledge
DATAFORGE_MODEL_BACKEND=deterministic
DATAFORGE_PROJECT_ID=datapulse-demo
# Set true only to enable cloud API dry runs; default OFF.
DATAFORGE_ENABLE_BIGQUERY_DRY_RUN=false
DATAFORGE_BIGQUERY_MAX_BYTES=100000000
# Qwen is opt-in and downloads model weights on the first use.
DATAFORGE_QWEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Phase 2 hosted inference is admin-gated through PRIVATE Streamlit Secrets.
# Do NOT paste HF_TOKEN or service account JSON into .env.example or GitHub.
# See docs/PHASE2_3_4.md for setup and honest status.
